# TokenIQ backend configuration
APP_NAME=TokenIQ
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8001

# PostgreSQL (matches docker-compose.yml at the repo root)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tokeniq_db
DB_USER=tokeniq
DB_PASSWORD=tokeniq_password
# Optional: a full URL overrides the DB_* values above
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/tokeniq_db

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Pricing baselines
COPILOT_SEAT_PRICE=30.0
CLAUDE_BASE_SEAT_PRICE=20.0
CHATGPT_SEAT_PRICE=30.0
