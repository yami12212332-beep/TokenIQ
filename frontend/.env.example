# Relative API base: the Vite dev server proxies /api to the backend.
# This keeps the app working for LAN clients (their localhost is not this machine).
VITE_API_URL=/
VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# Dev server (optional)
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=3001

# Demo mode: true = ChatGPT reads src/data/demoData.json.
# Copilot, Claude and the shared Overall users/trends always read the backend.
VITE_USE_DUMMY_DATA=true
