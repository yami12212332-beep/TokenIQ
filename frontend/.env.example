# Base URL of the FastAPI backend (no trailing /api - the client adds it).
VITE_API_URL=http://127.0.0.1:8001

# Dev server (optional)
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=3001

# Demo mode: true = Overall/Claude/ChatGPT read src/data/demoData.json.
# Set to false to read all tabs (except Copilot, which is always live) from PostgreSQL.
VITE_USE_DUMMY_DATA=true
